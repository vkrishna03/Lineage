# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lineage?sslmode=disable

# Server
PORT=8080

# ===================
# Kafka Configuration
# ===================

# Broker address (Aiven: copy "Service URI" from Overview tab)
KAFKA_BROKERS=localhost:9092

# Topic name (must exist - create in Aiven console)
KAFKA_TOPIC=lineage.events

# Consumer group ID (any string - Kafka creates it automatically)
KAFKA_GROUP_ID=lineage-consumer-group

# -------------------
# Aiven SASL Auth
# -------------------
# Set to true when using Aiven
KAFKA_SASL_ENABLED=false

# Aiven credentials (Users tab in Aiven console)
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
